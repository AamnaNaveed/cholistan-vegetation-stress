# Ignore RStudio user-specific files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Ignore raw data and large processed files to save space
data/raw/
data/processed/*.csv
!data/processed/data_dictionary.csv
!data/processed/novelty_summary_2024.csv

# Ignore large output files, but KEEP the small summary tables
outputs/figures/*.png
outputs/rasters/
!outputs/tables/